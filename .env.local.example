# ─── Обязательное: без этого приложение не поднимется ───
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Адрес, по которому платформа доступна снаружи. Без слэша в конце.
# Локально: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://creator-platform.vercel.app

# ─── Реквизиты для юридических страниц (/privacy, /terms, /data-deletion) ───
# Meta читает эти страницы при ревью, заглушки там недопустимы.
NEXT_PUBLIC_COMPANY_NAME=ТОО «Название агентства»
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.kz

# ─── Серверное: в браузер не попадает, в git не коммитим ───
# Нужен для скриптов импорта и для колбэков Meta (они приходят без сессии).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Instagram (подключается после одобрения в Meta, см. docs/META_APP_REVIEW.md) ───
# До одобрения можно не заполнять: страница подключения покажет «скоро».
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Секрет, которым Meta подписывает колбэки deauthorize и data deletion.
# Обычно совпадает с INSTAGRAM_APP_SECRET.
META_APP_SECRET=

# Ключ шифрования токенов Instagram в базе: 32 байта в hex.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
